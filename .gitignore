# =============================================================================
# Obligarth : LISTE BLANCHE (dépôt public).
# Règle des propriétaires : rien de ce qui n'est pas indispensable au build ne va
# sur GitHub. Tout est ignoré par défaut ; seuls les fichiers nécessaires pour
# construire et installer le produit sont ré-autorisés ci-dessous.
# Avant d'ajouter une ligne « ! », vérifier qu'elle n'apporte ni documentation,
# ni script interne, ni capture, ni donnée réelle.
# =============================================================================

# 1. Tout ignorer à la racine...
/*

# 2. ...sauf ce qui sert au build
!/.gitignore
!/.gitattributes
!/.dockerignore
!/package.json
!/package-lock.json
!/shared/
!/server/
!/client/
!/apple-edge/
!/docker-compose.build.yml

# ...et à l'installation : install.sh télécharge docker-compose.yml et
# .env.example depuis GitHub (voir la fin du fichier pour .env.example)
!/install.sh
!/docker-compose.yml

# ...et la licence (Elastic License 2.0, décision des propriétaires)
!/LICENSE

# 3. Jamais versionnés, même dans les dossiers autorisés
docs/
*.md
*.bat
*.cmd
*.ps1
*.jks
*.keystore
# Dossiers cachés : caches, secrets, éditeurs et outils du poste. Un dossier
# caché indispensable au build demande une exception « ! » placée après cette
# ligne.
.*/

# Tests et jeux de données de test : restent locaux (non indispensables au build)
*.test.*
*.spec.*
*_test.go
*e2e*
__tests__/
testdata/
test-resolve.mjs

# Artefacts et fichiers locaux
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
*.log
.DS_Store
Thumbs.db
.env
.env.*
!/.env.example

# ══════════════════════════════════════════════════════════════════════════════
# Durcissement avant recréation du dépôt (03/10/2026) : GitHub = de quoi BUILDER,
# rien d'autre. Tout ce qui suit reste sur le poste et n'est jamais publié.
# Toute exception se déclare en négation explicite, APRÈS ce bloc, avec sa raison.
# ══════════════════════════════════════════════════════════════════════════════

# Fichiers et dossiers cachés du poste (caches, sessions d'outils, éditeurs,
# brouillons, vérifications locales) : tous ignorés, sauf ceux du build, nommés
# un par un avec leur chemin (jamais un nom seul, qui vaudrait à toute
# profondeur) : règles du dépôt, contextes de build des images (racine pour le
# serveur et le client, apple-edge pour le sien), modèle de configuration que
# télécharge install.sh.
.*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/apple-edge/.dockerignore
!/.env.example
/AGENTS*
/REPRISE*
/HANDOFF*
/NOTES*
/TODO*
/PLAN*
*.jsonl

# Documentation, notes, exports bureautiques (peuvent contenir des données client)
docs/
doc/
docs-*/
*.md
*.markdown
*.txt
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.csv
*.tsv
*.har
*.pcap
*.pcapng

# Scripts d'outillage du poste (build, release, déploiement, bench)
*.bat
*.cmd
*.ps1
*.psm1
*.py
__pycache__/

# Journaux, sauvegardes, restes d'édition
*.log
/logs/
*.bak
*.orig
*.rej
*.pre-*
*.swp
*~
*.tmp

# Bases et dumps locaux
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.backup

# Secrets, clés et certificats
.env
.env.*
!/.env.example
*.pem
*.key
*.crt
*.cer
*.der
*.csr
*.jks
*.keystore
*.pfx
*.p12
*.p8
*.ppk
*.kdbx
*.secret
*.credentials
id_rsa*
id_ed25519*
id_ecdsa*
*.mobileprovision

# Tests et données de test : restent sur le poste (non nécessaires au build)
*.test.*
*.spec.*
*_test.go
*.verify.ts
*.selftest.ts
__tests__/
testdata/
fixtures/
golden/
*.golden
*.sample
*.export
**/testing/
/server/test/
/server/tests/
/client/test/
/client/tests/

# Binaires et sorties de build (produits sur le poste, jamais versionnés)
*.exe
*.msi
*.dll
*.syso
*.wixpdb
*.wixobj
*.dmg
*.pkg
*.zip
*.7z
*.tar.gz
*.tgz

# Données d'instance locales
custom/

# Version de l'agent pont embarquée dans l'image serveur (APK signé et release.json) :
# déposée par la mise à jour au moment du build, jamais versionnée.
/server/agent-release/

# Données locales du poste : jamais versionnées ni dans un build
.cache/

# Agent pont Android (canal legacy_agent) : sources du projet Gradle de l'APK,
# indispensables à son build (wrapper Gradle compris). Jamais : sorties de build,
# caches Gradle, local.properties (chemin du SDK, clé de signature), APK/AAB,
# tests. Les dossiers cachés (.gradle/, .kotlin/), *.bat (gradlew.bat), *.jks et
# *.keystore restent exclus par les règles ci-dessus.
!/agent-android/
agent-android/local.properties
agent-android/**/build/
agent-android/app/src/test/
agent-android/app/src/androidTest/
agent-android/**/*.apk
agent-android/**/*.aab
