<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Spec §8.2 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Requested, never required: IMEI (PAR-4). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- No effect under targetSdk 25; declared for a future raise. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- PackageInstaller.uninstall with a confirmation prompt (Android 9 and later). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!--
      Remote assistance (1.1.0, P0-15 §0.1, §8): the session's foreground service (no effect under
      targetSdk 25, declared for a future raise), the system dialog of MediaProjection reached through a
      full-screen notification from Android 10 (background starts blocked), the border over the screen when
      the user grants it (never required). Nothing here injects an input: the control (Knox RemoteInjection
      and its permissions) is T8.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
      Policies (1.3.0, lot PONT-POL §10.1): the Wi-Fi networks of the policy, and the files deposited in the external
      storage (asked once from the status screen, or granted by Knox when licensed, D1).
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!--
      Wi-Fi scan results (preferOver, C2): from Android 6 an app targeting 23+ reads an empty scan without a location
      permission. Asked from the status screen when a preferOver needs it, or granted by Knox when licensed.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      1.4.0 (lot BANC §7.1): no effect below Android 13; declared so that the bench (`pm grant`) and the owner of the
      device (setPermissionGrantState) can grant it on Android 13 and later.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Samsung Knox permissions of the policies used, both namespaces (§8.2, F-2).
      Granted by the licence activation; an unknown name is ignored by the system.
      Exact list to be confirmed against the Knox SDK documentation and on the
      device (PAR-2).
    -->
    <!-- Old namespace (android.app.enterprise, Knox < 2.8: the target fleet). -->
    <uses-permission android:name="android.permission.sec.MDM_APP_MGMT" />
    <uses-permission android:name="android.permission.sec.MDM_SECURITY" />
    <uses-permission android:name="android.permission.sec.MDM_INVENTORY" />
    <uses-permission android:name="android.permission.sec.MDM_PASSWORD" />
    <uses-permission android:name="android.permission.sec.MDM_HW_CONTROL" />
    <uses-permission android:name="android.permission.sec.MDM_LICENSE" />
    <!-- 1.3.0 (policies: restrictions, Wi-Fi, kiosk, certificates, runtime permissions); names to confirm on the J7 (§13.4). -->
    <uses-permission android:name="android.permission.sec.MDM_RESTRICTION" />
    <uses-permission android:name="android.permission.sec.MDM_WIFI" />
    <uses-permission android:name="android.permission.sec.MDM_KIOSK_MODE" />
    <uses-permission android:name="android.permission.sec.MDM_CERTIFICATE" />
    <uses-permission android:name="android.permission.sec.MDM_APP_PERMISSION_MGMT" />
    <uses-permission android:name="android.permission.sec.MDM_PHONE_RESTRICTION" />
    <!-- New namespace (com.samsung.android.knox, Knox 2.8 and later). -->
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_APP_MGMT" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_SECURITY" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_INVENTORY" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_HW_CONTROL" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_LICENSE" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_RESTRICTION_MGMT" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_WIFI" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_KIOSK" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_CERTIFICATE" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_APP_PERMISSION_MGMT" />
    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_PHONE_RESTRICTION" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_agent"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light"
        tools:ignore="GoogleAppIndexingWarning">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="tools.obli.obligarth.agent.action.ACTIVATE_ADMIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MessageActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen" />

        <!--
          The soft kiosk of the policy (1.3.0, lot PONT-POL §10.1): the activity itself is private; the alias KioskHome,
          off by default, makes it a HOME launcher while the policy enables a kiosk (KioskController).
        -->
        <!-- 1.4.0 (lot BANC §7.3): lockTaskMode if_whitelisted, the true kiosk of the owner of the device. -->
        <activity
            android:name=".KioskActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity-alias
            android:name=".KioskHome"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".KioskActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
          1.4.0: the guided choice of the agent as the default home ("finish the update"); its action FINISH_SETUP opens it
          from outside (a MobiControl sendintent). The alias HomeReset, off, is turned on for an instant to drop the choice
          of another launcher (KioskController.resetHomeChoice).
        -->
        <activity
            android:name=".HomeSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="tools.obli.obligarth.agent.action.FINISH_SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".HomeReset"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".HomeSetupActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".AgentAdminReceiver"
            android:description="@string/admin_description"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- Configuration sent by MobiControl (sendintent -b), spec §4.9 and §9. -->
        <receiver
            android:name=".ConfigReceiver"
            tools:ignore="ExportedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="tools.obli.obligarth.agent.action.CONFIGURE" />
            </intent-filter>
        </receiver>

        <!--
          The channel of the bench station (1.4.0, lot BANC §7.1, §7.4): `adb shell content call`. Exported without a
          permission on purpose: BenchProvider admits the shell (uid 2000) and root only, whatever an app holds.
          Once the agent owns the device and until it is enrolled, it is the only way to configure it.
        -->
        <provider
            android:name=".BenchProvider"
            android:authorities="${applicationId}.bench"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Activation screen back on each unlock while the administrator is off. -->
        <receiver
            android:name=".UnlockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".InstallStatusReceiver"
            android:exported="false" />

        <!-- Licence status from the Knox service. Exported by necessity: a status broadcast alone
             never decides the state (KnoxLicence): "licensed" only by a licensed call that works,
             a status taken only in the hour after a sending of this agent, and a refusal gives
             license_error only when that call fails too. -->
        <receiver
            android:name=".KnoxLicenseReceiver"
            tools:ignore="ExportedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="edm.intent.action.license.status" />
                <action android:name="edm.intent.action.knox_license.status" />
                <action android:name="com.samsung.android.knox.intent.action.LICENSE_STATUS" />
                <action android:name="com.samsung.android.knox.intent.action.KNOX_LICENSE_STATUS" />
            </intent-filter>
        </receiver>

        <service
            android:name=".PollJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".InstallJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".KeepAliveService"
            android:exported="false" />

        <!--
          Remote assistance (P0-15 §0.1, §8): the system dialog of MediaProjection, behind a transparent screen, asked
          at remote.open (no consent screen: nobody on the device answers; the agent never answers the dialog).
        -->
        <activity
            android:name=".ProjectionRequestActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="tools.obli.obligarth.agent.remote"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The session: its permanent notification stays all along (no Stop on the device). -->
        <service
            android:name=".ScreenShareService"
            android:exported="false" />
    </application>
</manifest>
