<?xml version="1.0" encoding="utf-8"?>
<!--
  Spec §8.2: force-lock and wipe-data. 1.3.0 (lot PONT-POL §10.1, D11): the policies of the agent policy. Never
  reset-password. An administrator activated before 1.3.0 holds the new ones once granted again (D12).
  1.4.0 (lot BANC §7.1): support-transfer-ownership (API 28, ignored before) prepares a future transfer of the owner
  role; no effect today. The policies stay for the administrators of the fleet.
-->
<device-admin>
    <support-transfer-ownership />
    <uses-policies>
        <force-lock />
        <wipe-data />
        <limit-password />
        <watch-login />
        <expire-password />
        <encrypted-storage />
        <disable-camera />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
