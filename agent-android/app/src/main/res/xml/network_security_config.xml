<?xml version="1.0" encoding="utf-8"?>
<!--
  Spec §8.2, RS-9: system store plus ISRG Root X1 and X2 (Android 7.0 does not
  know X1); cleartext forbidden; user certificates trusted in debug builds only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
