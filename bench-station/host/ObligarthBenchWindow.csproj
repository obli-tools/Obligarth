<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Obligarth bench station: the window. A native WinForms host of WebView2 (the runtime of Windows 10 and 11), so the
    station is an application of its own (its icon, its taskbar entry, no browser interface: no address bar, no
    translation offer, no sidebar, no bubble). .NET Framework 4.8 is part of every supported Windows: nothing to
    install. build.mjs builds it with the version of the station and puts it beside obligarth-bench.exe; the release
    signs it like the exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>obligarth-bench-window</AssemblyName>
    <RootNamespace>ObligarthBench</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\installer\obligarth-bench.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Obligarth Bench</Product>
    <Company>Obli tools</Company>
    <Copyright>Obli tools</Copyright>
    <AssemblyTitle>Obligarth Bench</AssemblyTitle>
    <Version>0.0.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
