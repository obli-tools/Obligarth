# ── Image version (Docker Hub tag, e.g. 1.0.0) ──
# Required, never "latest": every service runs this exact version (an image
# newer than the database's migrations must not start by surprise).
# install.sh writes it. To update: back up the database, set the new version,
# then docker compose pull && docker compose up -d (server-migrate migrates the
# database first, the server starts once it has succeeded).
# A local build (docker-compose.build.yml, docker-compose.dev.yml) takes any
# tag, e.g. dev.
OBLIGARTH_VERSION=

# ── Compose project name ──
# docker-compose.yml names the project "obligarth": its containers, network and
# database volume (obligarth_postgres_data). A second instance on the same
# Docker host (staging, say) needs its own name, or it would take over this
# instance's containers and database volume.
#COMPOSE_PROJECT_NAME=obligarth-staging

# ── Database ──
# The two accounts of the built-in postgres container (docker-compose.yml).
# Required: install.sh generates them; otherwise set random values
# (openssl rand -hex 24).
#   DB_PASSWORD: the server's account, role obligarth (no superuser rights,
#     owner of nothing, under row level security).
#   DB_ADMIN_PASSWORD: the administrator of the instance (obligarth_admin),
#     used only by the one-shot service server-migrate (roles, migrations),
#     never by the server.
# POSTGRES_* only act when the database volume is created: a volume created
# before (with the role obligarth as superuser) is refused by server-migrate.
DB_PASSWORD=
DB_ADMIN_PASSWORD=

# If using an external PostgreSQL (docker-compose.external-db.yml):
# DATABASE_ADMIN_URL=postgres://youradmin:adminpassword@your-db-host:5432/obligarth
#   an account that owns the database and may create roles (CREATEROLE),
#   used by server-migrate only
# DATABASE_URL=postgres://obligarth:yourpassword@your-db-host:5432/obligarth
#   yourpassword = DB_PASSWORD, given to the role obligarth by server-migrate

# ── Database context (row level security) ──
# Every query of the server runs in a database context (tenant, platform
# administrator's global view, account, job…).
# DB_CONTEXT_MODE: strict (default) = a query without a context fails; audit =
#   it is logged (DB_CONTEXT_MISSING) and runs without a tenant. audit is
#   accepted only until the row level security is switched on (migration C):
#   the server refuses to start with it afterwards.
# DB_CONTEXT_ASSERT: checks of the connection leases: throw, log (default in
#   production), off.
# PLATFORM_GRANT_TTL_SECONDS: lifetime of a platform administrator's global
#   view authorisation, 60 to 3600 (default 900).
# PLATFORM_GRANT_RETENTION_DAYS: how long those authorisations are kept, 30
#   or more (default 365).
# The key of the signed context is NOT set here: it is the file
# secrets/rls_context_key (Docker secret rls_context_key: 32 random bytes,
# base64, mode 600), created by install.sh; never in .env.
#DB_CONTEXT_MODE=strict
#DB_CONTEXT_ASSERT=log
#PLATFORM_GRANT_TTL_SECONDS=900
#PLATFORM_GRANT_RETENTION_DAYS=365

# ── Vault (encryption of the stored secrets) ──
# The key-encryption key (KEK) is NOT set here: it is the file secrets/server_kek
# (Docker secret server_kek, 32 random bytes, base64, mode 600), created by
# install.sh and never overwritten. Never in .env, never in a backup of the
# database: escrow it (see the documentation). The server refuses to start
# without it, or with a key that does not open this database's keys.
# VAULT_DEK_CACHE_TTL: seconds an unwrapped data key stays in memory, 0 to
#   86400 (default 300).
# VAULT_ALLOW_UNESCROWED: true lifts the escrow guard (Apple secrets accepted
#   before the vault keys are escrowed): laboratory instances only.
#KEK_PROVIDER=file
#VAULT_DEK_CACHE_TTL=300
#VAULT_ALLOW_UNESCROWED=false

# ── Apple devices (apple-edge, edge-proxy) ──
# MDM_PUBLIC_BASE: public URL of the device surface, https://mdm.<domain>,
#   without path or trailing slash. Required (install.sh writes it from
#   MDM_PUBLIC_BASE=… given to the installer). FINAL: the profiles of every
#   enrolled device point to it (ServerURL, CheckInURL, SCEP) and a device
#   never follows a change. Use a host name dedicated to the devices, under a
#   domain you keep (registry lock, DNSSEC, CAA), never a client's domain.
MDM_PUBLIC_BASE=
# The edge-proxy (nginx) terminates the TLS of that host name, with the
# certificate of MDM_TLS_DIR (fullchain.pem and privkey.pem, ECDSA P-256 or
# RSA 2048+, renewed by your ACME client) and edge-proxy/mdm.conf, replaced by
# install.sh at each run: to change it (PROXY protocol behind an L4 proxy of
# yours), copy it and name the copy in EDGE_PROXY_CONF.
#MDM_LISTEN_PORT=443
#MDM_TLS_DIR=./certs/mdm
#EDGE_PROXY_CONF=./edge-proxy/mdm.conf
# The secrets of apple-edge are NOT set here: files of secrets/ created by
# install.sh, never overwritten, owned by uid 65532 (apple-edge's user):
#   edge_kek               key-encryption key of apple-edge (escrow it with
#                          server_kek: vault escrow split --kek edge=…)
#   apple_edge_api_token   token of its internal API, shared with the server
#   apple_edge_ddm_hmac    key of the DDM relay, shared with the server
#   apple_edge_db_password password of its database role apple_edge_app
# EDGE_CROSS_TENANT_POLICY: a device identifier already enrolled in another
#   tenant: refuse (default; resolved by an approved transfer or a release)
#   or allow.
# EDGE_FAIL_LIMIT_PER_IP: failed unauthenticated device requests allowed per
#   minute and per address (default 60; 0 = off, required behind an L4 proxy
#   without the PROXY protocol, where every device shares one address).
# EDGE_DB_MAX_CONNS: connection pool of apple-edge (4 to 512, default 32);
#   postgres' max_connections (256 in docker-compose.yml) must cover it.
# EDGE_LOG_LEVEL: info (default) or debug (still without device data).
#EDGE_CROSS_TENANT_POLICY=refuse
#EDGE_FAIL_LIMIT_PER_IP=60
#EDGE_DB_MAX_CONNS=32
#EDGE_LOG_LEVEL=info
# The server's integration with apple-edge (enrollment, commands, events of
# its outbox) is switched on when it is delivered; keep both off until then.
#APPLE_EDGE_MODE=off
#OUTBOX_CONSUMER=off

# ── Background jobs (durable queue in the database, schema pgboss) ──
# Periodic and deferred work (sweeps, snapshots, report generation, retries)
# runs as durable jobs: they survive a restart and run once across instances.
# JOBS_MODE: all = run jobs and schedules (default); paused = keep jobs in the
#   queue without running them (after a database restore, during an incident:
#   /health/jobs then answers 503); api = this instance never runs jobs.
# GET /health/jobs (public, no detail) answers 200 while the scheduler and the
#   workers run, 503 otherwise: watch it from outside (Obliview).
# An invalid value of any JOBS_* setting stops the server at start.
#JOBS_MODE=all
# Advanced (rarely changed): pg-boss connection pool (2 to 50), LISTEN/NOTIFY
# wake-up (true/false), graceful stop in ms (1000 to 20000), largest age of the
# scheduler heartbeat for /health/jobs in seconds (90 to 3600). Not passed by
# docker-compose.yml: add them to the server's environment to change them.
#JOBS_DB_POOL_MAX=10
#JOBS_LISTEN_NOTIFY=true
#JOBS_STOP_TIMEOUT_MS=15000
#JOBS_HEALTH_MAX_HEARTBEAT_AGE_S=180

# ── Audit journal (append-only, one hash chain per tenant) ──
# Every administrative action is journaled; a critical action whose entry
# cannot be written is refused (503). Entries are sealed every hour (Merkle
# tree signed by a key kept in the vault) and copied to the SIEM destinations
# set in the console (Security > Journal settings): configure at least one in
# production. Retention: 12 months by default, per tenant in the console.
# AUDIT_SEAL_CRON: when the hourly seal runs (UTC, 5-field cron).
# AUDIT_TSA_URL: RFC 3161 time-stamping authority of the seals (empty:
#   disabled). AUDIT_TSA_CERT_SHA256 pins its certificate (SHA-256, hex);
#   AUDIT_TSA_TIMEOUT_MS: 1000 to 60000. A paid authority's Authorization
#   header goes in a file named by AUDIT_TSA_AUTH_FILE (a Docker secret).
# AUDIT_EXPORT: off stops the SIEM exporter (laboratory only).
# AUDIT_MAX_CLOCK_SKEW_SECONDS: the server refuses to start when its clock and
#   the database's differ by more (5 to 270, default 240): keep NTP on.
# AUDIT_SPOOL_DIR: entries waiting to be written while the journal is
#   unavailable (default ${CUSTOM_DIR}/audit-spool); replayed every minute.
#AUDIT_SEAL_CRON=12 * * * *
#AUDIT_TSA_URL=
#AUDIT_TSA_CERT_SHA256=
#AUDIT_TSA_TIMEOUT_MS=10000
#AUDIT_EXPORT=on
#AUDIT_MAX_CLOCK_SKEW_SECONDS=240

# ── Guards against mass erasure ──
# A destructive action (device records today, the MDM's erase and removal of
# management later) goes through the guarded actions: second factor, typed
# confirmation, a second approver for a batch (a client approver by default),
# a cancellable delay, an hourly cap, an emergency freeze (Security > Guards).
# Floors, delays and the 72-hour cooldown of new administrators are fixed.
# GUARD_APPROVAL_TTL_MINUTES: validity of an approval request of the guards
#   (30 to 4320, default 240).
#GUARD_APPROVAL_TTL_MINUTES=240

# ── Server ──
LISTEN_PORT=3005
# Only NODE_ENV=development accepts the built-in development fallbacks
# (session secret, local database) and weak secrets.
NODE_ENV=production
# Required: 32+ random characters (install.sh generates it; otherwise
# openssl rand -hex 32). Without it, or with a placeholder, the server refuses
# to start (except with NODE_ENV=development).
SESSION_SECRET=
# Session cookie name, distinct per app so Obli* apps served on the same
# hostname do not overwrite each other's session (cookies ignore ports): give
# a second Obligarth instance on the same hostname its own name too.
# Default: obligarth.sid
#SESSION_COOKIE_NAME=obligarth.sid

# ── Client origin (for CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost

# ── Public URL of this instance (e.g. https://obligarth.example.com) ──
# Used for links in e-mails and, with Obligate SSO, as the trusted origin of
# the OAuth redirect_uri: the SSO sign-in only proceeds on a host that is
# APP_URL, CLIENT_ORIGIN or this app's base URL registered in Obligate (the
# Host / X-Forwarded-* headers alone are never trusted). Set it when the base
# URL registered there is not the address users reach, or when several
# Obligarth instances share an Obligate that does not yet tell each app which
# registration is its own.
# Optional when CLIENT_ORIGIN already holds the public URL (the usual Docker
# setup): the server then uses CLIENT_ORIGIN as its public address for e-mail
# links and phone enrolment (a localhost CLIENT_ORIGIN is ignored). Set
# APP_URL only if it differs from CLIENT_ORIGIN.
# APP_URL=


# ── App name ──
# Issuer of the TOTP codes (entry name shown in authenticator apps), prefix of
# notification messages and e-mail subjects. A later change only renames the
# authenticator entries created after it.
APP_NAME=Obligarth

# ── Initial administrator (created at first start, while none exists) ──
# DEFAULT_ADMIN_PASSWORD empty: the server generates a random password and
# prints it ONCE in its startup logs (docker compose logs server).
# If set: 12+ characters and not a default value, or the server refuses to
# start (except with NODE_ENV=development). install.sh generates one and
# shows it once.
# At first sign-in, change it and enable two-factor authentication.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# ── Custom directory (reports, software repository, phone-key cache — persists across updates) ──
# Mounted at /custom inside the server container.
# Default: ./custom (next to your docker-compose.yml)
# Unraid example: CUSTOM_DIR=/mnt/user/appdata/obligarth/custom
# CUSTOM_DIR=./custom

# ── Obligate SSO — optional inbound secret ──
# The client_id sent to the browser is always the public id sha256(API key):
# Obligate refuses the raw key. OBLIGATE_CLIENT_ID_MODE is gone (ignored).
# Also in Settings > Obligate SSO Gateway; a value set here wins.
# OBLIGATE_INBOUND_SECRET: secret Obligate must present (Bearer) when it calls
#   this server (user sync, app info, dashboard stats). Empty = the API key is
#   expected. Set it ONLY once Obligate sends a separate secret, or its calls
#   are refused (401). At least 16 characters.
# OBLIGATE_INBOUND_SECRET=
#
# ── Delegated reads from sibling apps (X-Obli-Delegation, Obligate-signed) ──
# Obligate signs these tokens for any entitled user to whoever holds an app's
# API key.
# OBLIGATE_DELEGATION_APPS: source apps (signed azp) accepted, comma list.
#   Empty or none = off (the default: no app reads Obligarth this way yet).
#   Name a source app (e.g. oblidesk) only once it really reads Obligarth:
#   anyone holding its API key could then obtain tokens accepted here.
# OBLIGATE_DELEGATION_ALLOW_ADMIN: true = also accept a token whose subject is
#   a platform admin here (god view on every tenant). Empty = refused. Set it
#   only once the source apps send a public client id and their keys have
#   been regenerated in Obligate.
# OBLIGATE_DELEGATION_APPS=none
# OBLIGATE_DELEGATION_ALLOW_ADMIN=

# ── Device-bound 2FA (fingerprint validation from the Android app) ──
# Phones registered in the Obligarth Android app validate sensitive actions
# with the fingerprint instead of a code. On by default; the switches are in
# Settings > Phone validation. Requirements:
#   - the public address known: APP_URL (above), else CLIENT_ORIGIN when it
#     is the public URL (not localhost), matching the address the app uses;
#   - outbound HTTPS from the server to android.googleapis.com (Google's key
#     attestation revocation list, refreshed daily). Without it, enrolment
#     fails with "status_unavailable" once the cached list is 7 days old.
# DEVICE_KEYS_DISABLED: emergency switch, wins over the Settings switches.
#   Only the exact value "true" turns the feature off (keys are kept).
# DEVICE_KEY_ORIGINS: extra origins a phone may enrol through, next to
#   APP_URL (e.g. a LAN address). Comma-separated ASCII origins, scheme +
#   host (+ port), no path: https://obligarth.home.arpa:8443,https://10.0.0.5
# DEVICE_KEY_APP_IDS: accepted Android packages (comma list). Empty = the
#   official app (tools.obli.obligarth.next).
# DEVICE_KEY_APP_SIGNERS: accepted APK signing certificates, SHA-256 as 64 hex
#   characters (":" allowed and ignored), comma list. Empty = the official
#   release signer. Invalid entries are ignored (with a warning in the log).
#   Add a debug signer ONLY on a development server.
# DEVICE_KEY_BINDING_SECRET: secret of the request binding (HMAC). Empty =
#   derived from SESSION_SECRET. Never stored in the database.
# DEVICE_KEYS_SSO_ENABLED: fingerprint validation for Obligate (og_) accounts
#   ("lot O"). Off by default: turn it on ONLY after checking that the
#   Obligate in use implements the lot O contract (capabilities, MFA epoch,
#   consuming verify-totp, prompt=login re-authentication).
# DEVICE_KEYS_DISABLED=false
# DEVICE_KEY_ORIGINS=
# DEVICE_KEY_APP_IDS=
# DEVICE_KEY_APP_SIGNERS=
# DEVICE_KEY_BINDING_SECRET=
# DEVICE_KEYS_SSO_ENABLED=false

# ── Enable Watchtower and define the check interval to keep the containers up to date ──
#COMPOSE_PROFILES=watchtower
#WATCHTOWER_INTERVAL=3600

# ── Client IP behind reverse proxies ────────────────────────────────────────
# Only the X-Forwarded-For entries added by these proxies are believed; the
# client IP is the first address (from the right) that is not one of them.
# Comma-separated IPs, CIDRs or keywords: loopback, linklocal, uniquelocal,
# self (= the subnets of the server container's own interfaces, i.e. the
# client container's nginx whatever pool Docker uses).
# Default: loopback, self, 172.16.0.0/12 — covers the client nginx and an edge
# reverse proxy (Oblihub's nginx, Nginx Proxy Manager…) running in Docker on
# the same host. A proxy on another machine must be listed, e.g.
#   TRUSTED_PROXIES=loopback, self, 172.16.0.0/12, 192.168.1.10
# Cloudflare (orange cloud) in front: add Cloudflare's published ranges, or
# everyone shows up as a Cloudflare edge address.
# Do not add ranges that real clients use (LAN / VPN in 10/8, 172.16/12,
# 192.168/16 reaching the proxy directly): a client inside a trusted range
# could forge its address.
#TRUSTED_PROXIES=loopback, self, 172.16.0.0/12
# Maximum X-Forwarded-For hops believed: edge proxy + client nginx = 2. It
# stops the walk at a Docker gateway when the edge proxy cannot see the real
# client (IPv6 through docker-proxy, rootless Docker) instead of reading the
# client-written part. Use 1 if the client container's port is published
# directly with no reverse proxy in front.
#TRUSTED_PROXY_HOPS=2
